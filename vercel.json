{
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "node scripts/build-downloads.mjs",
  "headers": [
    {
      "source": "/downloads/recipient-studio-preview-3/:asset*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/recipient-verifier-preview-2/:asset*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
