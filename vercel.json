{
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "node scripts/build-downloads.mjs && node scripts/build-locales.mjs",
  "headers": [
    {
      "source": "/fachzugang/:path*",
      "headers": [
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/:locale(de|en|fr|it|ar)/fachzugang/:path*",
      "headers": [
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/downloads/recipient-studio-preview-3/:asset*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/recipient-verifier-preview-2/:asset*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/anmeldung/:path*",
      "headers": [
        {"key": "Content-Security-Policy","value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"},
        {"key": "X-Frame-Options","value": "DENY"},
        {"key": "X-Content-Type-Options","value": "nosniff"},
        {"key": "Referrer-Policy","value": "no-referrer"},
        {"key": "Permissions-Policy","value": "publickey-credentials-get=(self), publickey-credentials-create=(self)"},
        {"key": "Cache-Control","value": "private, no-store"}
      ]
    },
    {
      "source": "/:locale(de|en|fr|it|ar)/anmeldung/:path*",
      "headers": [
        {"key": "Content-Security-Policy","value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"},
        {"key": "X-Frame-Options","value": "DENY"},
        {"key": "X-Content-Type-Options","value": "nosniff"},
        {"key": "Referrer-Policy","value": "no-referrer"},
        {"key": "Permissions-Policy","value": "publickey-credentials-get=(self), publickey-credentials-create=(self)"},
        {"key": "Cache-Control","value": "private, no-store"}
      ]
    }
  ],
  "redirects": [
    {"source": "/anmeldung/:path*","has": [{"type": "host","value": "www.authzledger.com"}],"destination": "https://authzledger.com/anmeldung/:path*","permanent": false},
    {"source": "/anmeldung/:path*","has": [{"type": "host","value": "authzledger.vercel.app"}],"destination": "https://authzledger.com/anmeldung/:path*","permanent": false},
    {"source": "/anmeldung/:path*","has": [{"type": "host","value": "authzledger-auth-zl-edger.vercel.app"}],"destination": "https://authzledger.com/anmeldung/:path*","permanent": false},
    {"source": "/:locale(de|en|fr|it|ar)/anmeldung/:path*","has": [{"type": "host","value": "www.authzledger.com"}],"destination": "https://authzledger.com/:locale/anmeldung/:path*","permanent": false},
    {"source": "/:locale(de|en|fr|it|ar)/anmeldung/:path*","has": [{"type": "host","value": "authzledger.vercel.app"}],"destination": "https://authzledger.com/:locale/anmeldung/:path*","permanent": false},
    {"source": "/:locale(de|en|fr|it|ar)/anmeldung/:path*","has": [{"type": "host","value": "authzledger-auth-zl-edger.vercel.app"}],"destination": "https://authzledger.com/:locale/anmeldung/:path*","permanent": false}
  ]
}
