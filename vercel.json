{
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "node scripts/build-downloads.mjs && node scripts/build-locales.mjs",
  "headers": [
    {
      "source": "/fachzugang/:path*",
      "headers": [
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/:locale(de|en|fr|it|ar)/fachzugang/:path*",
      "headers": [
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/downloads/recipient-studio-preview-3/:asset*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/recipient-verifier-preview-2/:asset*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
